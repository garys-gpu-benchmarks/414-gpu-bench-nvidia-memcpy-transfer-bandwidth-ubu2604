  },
  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Measure H2D/D2H/D2D transfer bandwidth"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates positive bandwidth for every swept size. Metric #5 is a pinned/pageable ratio"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: H2D bandwidth at max transfer size, GB/s (bandwidth_h2d_gbps); #2: D2H bandwidth at max transfer size, GB/s (bandwidth_d2h_gbps); #3: D2D bandwidth at max transfer size, GB/s (bandwidth_d2d_gbps); #4: H2D latency at min transfer size, us (latency_h2d_us); #5: D2H latency at min transfer size, us (latency_d2h_us); #6: D2D latency at min transfer size, us (latency_d2d_us); #7: Pageable ratio (pinned_vs_pageable_bandwidth_ratio)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile cuda_memcpy.cu with nvcc; run bin/cuda_memcpy for H2D, D2H, D2D, and H2D_pageable"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/cuda_memcpy.cu with nvcc and run H2D, D2H, D2D, and H2D_pageable at each geometric transfer size from min_bytes to max_bytes, parse bandwidth and H2D latency, and record pinned/pageable as the H2D ratio, to measure copy bandwidth. yaml direction and pinned_memory do not restrict which copies run"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/cuda_memcpy.cu with nvcc and run H2D, D2H, D2D, and H2D_pageable at each geometric size from min_bytes to max_bytes. Parse bandwidth and H2D latency, and record the pinned-to-pageable H2D ratio. yaml direction and pinned_memory do not restrict which copies run"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Builds src/cuda_memcpy.cu and sweeps transfer sizes from min_bytes to max_bytes by step_factor. Each size always runs H2D, D2H, D2D, and H2D_pageable. device_id: GPU index. warmup_iters and num_iterations time cudaMemcpy with CUDA events. yaml direction and pinned_memory are ignored; all four kinds run every size. Bandwidth is recorded at max_bytes and latency (time per copy) for H2D, D2H, and D2D at min_bytes"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Memory / Transfer"
  },
  {
    "field_name": "Workload Category",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Memory, Bandwidth & Data Movement"
  },
  {
    "field_name": "Workload Type",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Benchmark"
  },
  {
    "field_name": "Target Hardware",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "GPU"
  },
  {
    "field_name": "GPU Model",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "H100 SXM 80GB"
  },
  {
    "field_name": "Raw Output Format",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "CSV with H2D, D2H, and D2D bandwidth and latency on each transfer-size row"
  },
  {
    "field_name": "Primary Record Granularity",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "one row per transfer size. A single size is duplicated to two samples"
  },
  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,status,transfer_size_bytes,bandwidth_h2d_gbps,bandwidth_d2h_gbps,bandwidth_d2d_gbps,latency_h2d_us,latency_d2h_us,latency_d2d_us,pinned_vs_pageable_host_memory_bandwidth_gb_s,pinned_vs_pageable_bandwidth_ratio,error_message\n0,ok,268435456,25,24,700,8,9,2,20,1.4,"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --device-id 0 --direction all --pinned-memory true --min-bytes 1024 --max-bytes 4096 --step-factor 2 --warmup-iters 1 --num-iterations 3"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --device-id 0 --direction all --pinned-memory true --min-bytes 1024 --max-bytes 1073741824 --step-factor 2 --warmup-iters 5 --num-iterations 750"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --device-id 0 --direction all --pinned-memory true --min-bytes 1024 --max-bytes 1073741824 --step-factor 2 --warmup-iters 10 --num-iterations 2200"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bandwidth_h2d_gbps, bandwidth_d2h_gbps, bandwidth_d2d_gbps, latency_h2d_us, latency_d2h_us, latency_d2d_us, pinned_vs_pageable_host_memory_bandwidth_gb_s, pinned_vs_pageable_bandwidth_ratio"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "status=ok, the largest size has positive H2D, D2H, and D2D bandwidth, and the smallest size has latencies"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Bandwidth columns are filled only on the largest-size row and latency (time per copy) only on the smallest-size row; other rows are blank, so each summary value is that single measurement. pinned_vs_pageable_host_memory_bandwidth_gb_s is the H2D pinned/pageable ratio. Per-size transcripts stay in the run directory"
  },
